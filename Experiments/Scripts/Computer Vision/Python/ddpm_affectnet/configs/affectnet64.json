{
  "run_name": "affectnet64_uncond",
  "_notation": "diffusers beta_start / beta_end / betas are the book's beta_i^2 (Ho's variances); alphas_cumprod is alphaBar_i^2 (Lai et al. Sec. 2.2).",
  "data": {
    "image_size": 64,
    "test_fraction": 0.2,
    "split_seed": 0,
    "hflip": true
  },
  "model": {
    "sample_size": 64,
    "in_channels": 3,
    "out_channels": 3,
    "layers_per_block": 2,
    "block_out_channels": [64, 128, 256, 256],
    "down_block_types": ["DownBlock2D", "DownBlock2D", "AttnDownBlock2D", "DownBlock2D"],
    "up_block_types": ["UpBlock2D", "AttnUpBlock2D", "UpBlock2D", "UpBlock2D"],
    "dropout": 0.1
  },
  "diffusion": {
    "num_train_timesteps": 1000,
    "beta_schedule": "linear",
    "beta_start": 0.0001,
    "beta_end": 0.02,
    "prediction_type": "epsilon",
    "clip_sample": true
  },
  "train": {
    "steps": 30000,
    "batch_size": 64,
    "lr": 0.0002,
    "warmup_steps": 1000,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "ema_decay": 0.9999,
    "precision": "auto",
    "seed": 0,
    "log_every": 50,
    "checkpoint_every": 2000,
    "sample_every": 5000,
    "preview_images": 16,
    "preview_ddim_steps": 50
  },
  "sample": {
    "seed": 1,
    "grid_images": 64,
    "ddpm_steps": 1000,
    "fid_images": 2000,
    "fid_ddim_steps": 50,
    "trajectory_images": 4,
    "trajectory_frames": 11
  }
}
